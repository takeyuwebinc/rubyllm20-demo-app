# Copy to .env and fill in the values. .env is git-ignored; this file is not.
# How to obtain each key: docs/api-keys.md
# Verify after editing:    bin/check_keys

# OpenAI — Responses API, Tool Approval, Batches, Fallbacks (primary), Speech,
#          Provider Tools, count_tokens, Workflow Instrumentation
OPENAI_API_KEY=

# Anthropic — Citations, Fallbacks (fallback target)
ANTHROPIC_API_KEY=

# xAI — Video generation, RubyLLM.tokenize
XAI_API_KEY=

# Vertex AI — Deep Research only. Authenticates with Application Default
# Credentials (gcloud auth application-default login), so there is no API key.
# Hosted research requires the location to be exactly "global".
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
