<%# The tickets come in the order they were submitted, which is the order of the batch's requests. A ticket whose request
    failed or was cancelled has no answer; RubyLLM logs why a request failed, and the batch reports no reason. A ticket
    answered with something that does not read as a category keeps its answer in its chat only. %>
<% result = run.result %>
<div data-batch-classification class="max-w-prose space-y-6">
  <dl class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-1 text-sm">
    <dt class="text-gray-500"><%= Demos.provider_name(result["provider"]) %> の状態</dt>
    <dd data-batch-status class="font-mono text-gray-900"><%= result["raw_status"] %></dd>
    <dt class="text-gray-500">件数</dt>
    <dd data-batch-counts class="text-gray-800"><%= request_counts_text(result["request_counts"]) %></dd>
    <dt class="text-gray-500">バッチ ID</dt>
    <dd data-batch-id class="break-all font-mono text-gray-800"><%= result["batch_id"] %></dd>
    <dt class="text-gray-500">応答したモデル</dt>
    <dd data-batch-model class="text-gray-800"><%= result["model"] || "—" %></dd>
  </dl>

  <ol class="space-y-4">
    <% result["tickets"].each do |ticket| %>
      <li data-ticket class="space-y-2 rounded-md p-4 ring-1 ring-gray-200">
        <div class="flex items-start justify-between gap-4">
          <p data-ticket-text class="whitespace-pre-wrap break-words text-gray-900"><%= ticket["text"] %></p>
          <%= request_status_badge(ticket["status"]) %>
        </div>
        <% if ticket["status"] == "succeeded" && ticket["category"] %>
          <dl class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-1 text-sm">
            <dt class="text-gray-500">区分</dt>
            <dd data-ticket-category class="font-medium text-gray-900"><%= ticket["category"] %></dd>
            <dt class="text-gray-500">理由</dt>
            <dd data-ticket-reason class="break-words text-gray-800"><%= ticket["reason"] %></dd>
          </dl>
        <% elsif ticket["status"] == "succeeded" %>
          <p data-ticket-unreadable class="text-sm text-gray-600">回答はあるが、区分として読めなかった。回答の本文は会話の記録（<code>chats</code> と <code>messages</code>）にある。</p>
        <% elsif ticket["status"] == "cancelled" %>
          <p data-ticket-missing class="text-sm text-gray-600">回答がない。バッチが取り消されたため、処理されなかった。</p>
        <% else %>
          <p data-ticket-missing class="text-sm text-gray-600">回答がない。失敗の理由は RubyLLM のログ（このアプリでは <code>bin/dev</code> の端末）に出る。</p>
        <% end %>
      </li>
    <% end %>
  </ol>
</div>
