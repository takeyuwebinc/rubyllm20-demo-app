<% content_for :title, "実行 ##{@run.id}" %>
<% scenario = @run.scenario %>

<div class="space-y-8">
  <header>
    <% if run_demo_name(@run) %>
      <p class="text-sm text-gray-500"><%= run_demo_name(@run) %></p>
    <% end %>
    <h1 class="text-2xl font-bold"><%= run_title(@run) %></h1>
  </header>

  <% if @decision_refused %>
    <p data-decision-refused class="max-w-prose rounded-md bg-red-50 px-4 py-3 text-sm text-red-800"><%= @decision_refused %></p>
  <% end %>

  <%= render "runs/details", run: @run %>

  <section>
    <h2 class="text-base font-semibold text-gray-700">入力</h2>
    <dl class="mt-2 max-w-prose space-y-3">
      <% @run.input.each do |name, value| %>
        <div>
          <dt class="text-sm text-gray-500"><%= input_label(@run, name) %></dt>
          <dd class="mt-1 whitespace-pre-wrap break-words text-sm text-gray-800"><%= value %></dd>
        </div>
      <% end %>
    </dl>
  </section>

  <% if scenario %>
    <div class="flex flex-wrap items-center gap-3">
      <%= link_to "この入力でデモを開く", demo_path(scenario.demo_key, from_run: @run.id, anchor: scenario.key), class: "btn-secondary" %>
      <%= link_to "デモに戻る", demo_path(scenario.demo_key), class: "btn-secondary" %>
    </div>
  <% end %>
</div>
