<%# The part of the run page that changes while the run is in progress. %>
<div id="run_details" class="space-y-6"
     data-controller="poll"
     data-poll-url-value="<%= run_status_path(run) %>"
     data-poll-active-value="<%= run.running? %>">
  <div>
    <%# The Sentry links sit on the status row so that a long result does not push them out of sight. They stay in this
        part, not the page header, so a trace recorded while the run is in progress appears with the next poll. %>
    <div data-run-status-row class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
      <div class="flex items-center gap-3">
        <%= run_status_badge(run, size: :large) %>
        <% if run.running? %>
          <span class="text-sm text-gray-600">実行を指示してから <%= (Time.current - run.created_at).to_i %> 秒</span>
        <% end %>
      </div>
      <% if sentry_links.available? %>
        <div data-sentry-links class="flex flex-wrap items-center gap-3">
          <% newest, *older = run.traces.reverse %>
          <% if newest %>
            <%# While the run waits for a decision, 承認する is the page's one primary action. Once the run has ended,
                the trace is the main way to look into what happened, so the link takes the primary rank back. %>
            <%= link_to "Sentry でトレースを開く", sentry_trace_url(newest), target: "_blank", rel: "noopener",
                  class: run.awaiting_approval? ? "btn-secondary" : "btn-primary" %>
          <% end %>
          <%= link_to "Sentry で会話を開く", sentry_conversation_url(run), target: "_blank", rel: "noopener", class: "btn-secondary" %>
          <% older.each.with_index(1) do |trace, index| %>
            <%= link_to "以前のトレース #{index}", sentry_trace_url(trace), target: "_blank", rel: "noopener", class: "btn-secondary" %>
          <% end %>
        </div>
      <% else %>
        <p data-sentry-links class="text-sm text-gray-500">Sentry へのリンクには、<code>.env</code> の <code>SENTRY_ORG</code> と <code>SENTRY_DSN</code> が要る。</p>
      <% end %>
    </div>
    <%# Shown for as long as the run keeps the id, finished or not: it says the provider holds the work, and gives the id
        to open that work again from a console. Work that is checked on has a section of its own below, with the id. %>
    <% if run.remote_job_id && !run.remote_job %>
      <p data-remote-job-id class="mt-2 text-sm text-gray-600">
        プロバイダー側の処理の ID: <code class="rounded bg-gray-100 px-1 py-0.5 break-all"><%= run.remote_job_id %></code>
      </p>
    <% end %>
    <% if run.running? %>
      <p class="mt-2 max-w-prose text-sm text-gray-500">
        進まない場合は、ジョブのワーカーが動いているかを確かめる。<code>bin/dev</code> で起動すると、Web のサーバーと一緒に動く。
      </p>
    <% end %>
  </div>

  <% if run.remote_job %>
    <%= render "runs/remote_job", run: run %>
  <% end %>

  <% if run.running? && run.retries.positive? %>
    <section data-retry class="max-w-prose rounded-md border border-amber-200 bg-amber-50 p-4">
      <p class="text-sm text-amber-900">
        続きの取得に失敗し、<%= Demos::RunJob::RETRY_INTERVAL.in_minutes.to_i %> 分後にやり直す（<%= run.retries %> 回目、上限 <%= Demos::Run::MAX_RETRIES %> 回）。
      </p>
      <div class="mt-3">
        <%= render "runs/failure_reason", failure: run.failure, title_class: "text-amber-900", message_class: "text-amber-950" %>
      </div>
    </section>
  <% end %>

  <% if run.awaiting_approval? %>
    <section data-approval class="max-w-prose space-y-4 rounded-md border border-amber-200 bg-amber-50 p-4">
      <h2 class="font-semibold text-amber-900">AI がツールの実行を提案している</h2>
      <% run.approval_requests.each do |request| %>
        <div data-approval-request="<%= request["tool_call_id"] %>" class="space-y-3 rounded-md bg-white p-4 ring-1 ring-amber-600/20">
          <p class="text-sm text-gray-700">ツール: <code class="rounded bg-gray-100 px-1 py-0.5"><%= request["name"] %></code></p>
          <%= tool_arguments_list(request["arguments"] || {}) %>
          <% if request["decision"] %>
            <p class="text-sm font-medium text-gray-900">決定: <%= decision_label(request["decision"]) %></p>
          <% else %>
            <div class="flex flex-wrap items-center gap-3">
              <%= button_to "承認する", run_decision_path(run), params: { tool_call_id: request["tool_call_id"], decision: "approve" }, class: "btn-primary" %>
              <%= button_to "却下する", run_decision_path(run), params: { tool_call_id: request["tool_call_id"], decision: "deny" }, class: "btn-secondary" %>
            </div>
          <% end %>
        </div>
      <% end %>
      <p class="text-sm text-amber-900">
        承認するとツールが実行され、AI はその結果を踏まえて続きを実行する。却下するとツールは実行されず、AI は却下を踏まえて応答する。
        画面を離れても、履歴からこの実行を開いて決められる。
      </p>
    </section>
  <% end %>

  <%# A run cancelled at the provider says why, as a failed one does. The reason comes before the result: a failed or
      cancelled run's result holds only what the provider finished. %>
  <% if run.failed? || (run.cancelled? && run.failure) %>
    <section data-failure class="max-w-prose rounded-md border border-red-200 bg-red-50 p-4">
      <%= render "runs/failure_reason", failure: run.failure || {}, title_class: "text-red-800", message_class: "text-red-900" %>
    </section>
  <% end %>

  <% if run.result %>
    <% result_kind = run.scenario&.result_kind || "raw" %>
    <div data-run-result>
      <%= render "runs/results/#{result_kind}", run: run %>
    </div>
  <% end %>

  <dl class="grid max-w-xl grid-cols-[auto_1fr] gap-x-6 gap-y-1 text-sm">
    <dt class="text-gray-500">実行日時</dt>
    <dd class="text-gray-800"><%= format_time(run.created_at) %></dd>
    <dt class="text-gray-500">終了日時</dt>
    <dd class="text-gray-800"><%= format_time(run.finished_at) || "—" %></dd>
  </dl>
</div>
