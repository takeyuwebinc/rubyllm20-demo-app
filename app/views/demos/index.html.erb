<% content_for :title, "デモの一覧" %>

<h1 class="text-2xl font-bold">デモの一覧</h1>

<ul class="mt-6 divide-y divide-gray-200 rounded-lg border border-gray-200 bg-white">
  <% @demos.each do |demo| %>
    <li data-demo="<%= demo.key %>" class="relative flex items-start justify-between gap-4 px-5 py-4 hover:bg-gray-50">
      <div class="min-w-0">
        <%= link_to demo.name, demo_path(demo.key), class: "font-semibold text-indigo-700 after:absolute after:inset-0" %>
        <p class="mt-1 max-w-prose text-sm text-gray-600"><%= demo.summary %></p>
      </div>
      <%= availability_badge(demo.availability) %>
    </li>
  <% end %>
</ul>
